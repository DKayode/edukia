# ─────────────────────────────────────────────────────────────────────────────
# Edukia backend — local dev environment template.
#   cp backend/.env.example backend/.env   then fill in the blanks.
#
# This file is committed (template only). The real backend/.env is gitignored.
#
# ⚠️  NEVER point a dev machine at the PRODUCTION database.
#     Use the shared TEST database `edukia-dev` (ask a maintainer for the URL).
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (Neon Postgres) ------------------------------------------------
# TEST database only. The host/credentials come from the edukia-dev Neon project.
# Must end with ?sslmode=require for Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/edukia-dev?sslmode=require

# --- Auth --------------------------------------------------------------------
# Any non-empty string for local dev. Does NOT need to match production.
JWT_SECRET=dev-only-change-me

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8080
# CONFIG_PATH=./config/config.json   # optional; this is the default

# --- Redis (BullMQ queue) ----------------------------------------------------
# Easiest: `docker compose -f docker-compose.dev.yml up -d redis`
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Protection de l'aperçu des codes promotionnels -------------------------
# Nombre maximal de validations par compte authentifié.
CODE_VALIDATION_RATE_LIMIT_BURST=10
CODE_VALIDATION_RATE_LIMIT_HOURLY=100

# --- Eligibilite des quotas gratuits par appareil (#227) -------------------
# off: aucune restriction; monitor: mesure sans refuser; enforce: preuve
# obligatoire et trois comptes gratuits maximum par appareil.
DEVICE_CREDIT_CONTROL_MODE=off
DEVICE_CREDIT_MAX_ACCOUNTS=3
DEVICE_CREDIT_HMAC_SECRET=change-me-with-at-least-32-random-characters
DEVICE_CREDIT_PROVIDER_TIMEOUT_MS=5000
DEVICE_CREDIT_ATTESTATION_MAX_AGE_MS=120000

# Android Play Integrity + Device Recall (service account JSON sur une ligne).
PLAY_INTEGRITY_PACKAGE_NAME=
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=

# Apple DeviceCheck. Utiliser development pour les builds locaux, production
# pour TestFlight et App Store. La cle p8 peut etre fournie en base64.
APPLE_DEVICECHECK_ENVIRONMENT=development
APPLE_DEVICECHECK_TEAM_ID=
APPLE_DEVICECHECK_KEY_ID=
APPLE_DEVICECHECK_PRIVATE_KEY_BASE64=

# --- Cloudflare R2 (USE THE DEV BUCKETS, not prod) ---------------------------
# Same Cloudflare account as prod; only the bucket names differ.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=edukia-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=edukia-public-dev
R2_PUBLIC_BUCKET_URL=https://assets-dev.edukia.net

# --- SMTP (transactional email) ----------------------------------------------
# For dev use a mail catcher (Mailpit/Mailtrap). Leave blank to no-op if your
# task doesn't send mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Firebase (legacy storage, transitional — being retired) -----------------
# Also requires the file backend/config/firebase-serviceaccount.json
# (see firebase-serviceaccount.example.json for its shape). The backend will
# NOT boot without that file present.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Kessiah : lecture des épreuves -------------------------------------
# Kessiah transcrit chaque épreuve validée (couche texte du PDF, ou OCR pour
# les scans) et en sert le texte à son assistante. Edukia n'implémente aucune
# extraction : il déclenche celle de Kessiah à l'approbation d'une soumission,
# et relaie le verdict de l'admin sur la transcription.
# Laisser vide désactive proprement l'intégration : l'approbation fonctionne
# comme avant, sans appel sortant.
KESSIAH_API_BASE_URL=https://kessiah-api.ai4smartbusiness.com

# Clé des appels de serveur à serveur (en-tête X-Service-Key). DISTINCTE de la
# clé applicative embarquée dans l'APK : celle-ci autorise des opérations
# d'administration — déclencher une extraction, valider une transcription — et
# ne doit jamais être exposée côté client.
#
# LA VALEUR RÉELLE NE FIGURE PAS ICI : ce fichier est versionné et poussé.
# Elle se renseigne dans backend/.env, qui lui est ignoré par git.
#
# Elle doit être IDENTIQUE à SERVICE_API_KEY côté Kessiah
# (kessiah-backends/.env). Si les deux divergent, Kessiah répond 401 et
# l'intégration se tait sans erreur visible : l'approbation d'une soumission
# est volontairement tolérante aux pannes de ce service, une clé fausse
# ressemble donc à une intégration désactivée.
#
# Pour en générer une nouvelle : python -c "import secrets; print(secrets.token_urlsafe(32))"
KESSIAH_SERVICE_KEY=

# --- Paiements entrants abonnements (#248) ----------------------------------
# Prestataires lancés derrière abstraction : KKIAPAY et FEDAPAY.
PAIEMENT_PRESTATAIRE_DEFAUT=KKIAPAY
PAIEMENT_MODE=sandbox
PAIEMENT_WEBHOOK_BASE_URL=http://localhost:3000
PAIEMENT_CREDENTIALS_SECRET=change-me-with-a-long-random-secret

KKIAPAY_API_BASE_URL=https://api.kkiapay.me
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=

FEDAPAY_API_BASE_URL=https://api.fedapay.com/v1
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
